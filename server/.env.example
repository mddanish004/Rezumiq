# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# Local development only needs DATABASE_URL, DJANGO_SECRET_KEY, and a Groq key.
# Production needs the required values marked below plus SMTP and a public URL.

# --- Core -------------------------------------------------------------------

# Required. Local Postgres (docker compose up -d):
#   postgres://rezumiq:rezumiq@localhost:5432/rezumiq
# Or a Neon pooled connection string (host ends in -pooler).
DATABASE_URL=

# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Rotating it invalidates sessions, password-reset links, and encrypted BYOK keys
# unless AI_KEY_ENCRYPTION_SECRET is set.
DJANGO_SECRET_KEY=

# Keep true locally; false in production.
DJANGO_DEBUG=true

# Comma separated. Production adds the API host, e.g. api.rezumiq.com
ALLOWED_HOSTS=localhost,127.0.0.1

# The public frontend origin. Share links, redirects, and auth email links are built from this.
# Local: http://localhost:5173   Production: https://rezumiq.com
FRONTEND_URL=http://localhost:5173

# --- Auth and mail ----------------------------------------------------------

# Google OAuth 2.0 Web client. Authorized redirect URI:
#   <API_URL>/accounts/google/login/callback/
# Local: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional extra providers shown in the admin readiness list.
GITHUB_CLIENT_ID=
CHATGPT_CLIENT_ID=

# Parent domain for the shared session cookie, e.g. .rezumiq.com. Empty in dev.
COOKIE_DOMAIN=

# Lax works for app.example.com calling api.example.com. Use None only when the
# frontend and API share no site (vercel.app to onrender.com); None requires HTTPS.
COOKIE_SAMESITE=Lax

# Required in production (verification and password reset cannot work without it).
# Locally, an empty SMTP_HOST prints mail to the console when DJANGO_DEBUG=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=Rezumiq <no-reply@rezumiq.com>

# Emails allowed to open the admin control room and /v1/admin endpoints.
# The address must also be verified through allauth.
ADMIN_EMAILS=

# Dev-only guest accounts. Uncomment locally; defaults to DJANGO_DEBUG, which is
# false in production.
# ENABLE_GUEST_LOGIN=true

# --- CORS and cookies -------------------------------------------------------

# React origins allowed to call the API with session cookies. Comma separated.
# Add preview deployment origins when testing them.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Must contain the frontend origin(s); defaults to CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=

# --- AI ---------------------------------------------------------------------

# groq (default), openai, anthropic, or openrouter for the server key.
AI_PROVIDER=groq

# Required for AI features on the free tier. Get a key at console.groq.com.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Override the default models. Groq defaults are openai/gpt-oss-20b (fast)
# and openai/gpt-oss-120b (smart).
AI_MODEL_FAST=
AI_MODEL_SMART=

# Stamped into prompts and shown in the admin readiness list.
JINA_API_KEY=

# Encrypts users' own (BYOK) provider keys at rest. Set a long random value in
# production and keep it stable; rotating it breaks every stored BYOK key.
# Falls back to DJANGO_SECRET_KEY when empty.
AI_KEY_ENCRYPTION_SECRET=

# --- LaTeX compiler ---------------------------------------------------------

# Install locally: brew install tectonic, or the release binary on Linux.
# The Docker image ships tectonic 0.17.0.
TECTONIC_BIN=tectonic
# Production compiles only from the cached bundle; set false for a local first run.
TECTONIC_ONLY_CACHED=false
COMPILE_TIMEOUT_MS=20000
COMPILE_CONCURRENCY=2
# Optional remote compiler service. Leave empty to compile in-process.
COMPILER_URL=

# --- Storage ----------------------------------------------------------------

# local (dev) or r2 (production).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Payments (Dodo) --------------------------------------------------------

# Create a one-time Season Pass product and a recurring Pro product in the Dodo
# dashboard, then put their ids here. Missing keys make checkout and refunds
# answer 503 PAYMENTS_NOT_CONFIGURED.
#
# Test mode uses test_mode keys and test products. Live mode needs its own key
# and its own two products; the test ids do not work in live mode.
DODO_API_KEY=
DODO_ENVIRONMENT=test_mode
DODO_SEASON_PASS_PRODUCT_ID=
DODO_PRO_PRODUCT_ID=
# Webhook secret from the Dodo endpoint. Webhooks post to
# <API_URL>/v1/webhooks/dodo and the value starts with whsec_.
# Generate one locally with: dodo wh listen (or the dashboard).
DODO_WEBHOOK_KEY=

# --- Product analytics (optional) -------------------------------------------

POSTHOG_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_URL=https://app.posthog.com
